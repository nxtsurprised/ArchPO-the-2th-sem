# ============================================================
# ГОСТ 34 Docs System — Environment Variables
# Copy to .env and fill in real values
# ============================================================

# Database passwords
AUTH_DB_PASSWORD=auth_secret_change_me
WORKFLOW_DB_PASSWORD=workflow_secret_change_me
CATALOG_MONGO_PASSWORD=catalog_secret_change_me

# MinIO
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin_change_me

# Internal API secret (shared between all services)
INTERNAL_API_SECRET=internal_secret_change_me

# Field-level encryption keys (generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
ENCRYPT_KEY_PHONE=generate_me_with_fernet
ENCRYPT_KEY_TOTP=generate_me_with_fernet

# SMTP (for password reset, lockout notifications)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=noreply@system.gov.ru
SMTP_PASSWORD=smtp_secret
