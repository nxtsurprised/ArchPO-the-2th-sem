# MongoDB
MONGO_HOST=localhost
MONGO_PORT=27017
MONGO_DB=catalog_db
MONGO_USER=catalog_user
MONGO_PASSWORD=catalog_secret

# JWT verification — choose one:
#   Production: fetch JWKS from Auth Service
JWKS_URL=http://auth-service:8001/.well-known/jwks.json
#   Development / tests: verify with local PEM file
JWT_PUBLIC_KEY_PATH=

# Inter-service
AUTH_SERVICE_URL=http://auth-service:8001
WORKFLOW_SERVICE_URL=http://workflow-service:8004
INTERNAL_API_SECRET=internal_secret

APP_VERSION=1.0.0
