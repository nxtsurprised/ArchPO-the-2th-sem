# PMI Agent — переменные окружения
# Скопируйте в .env и заполните значения

# ─── LLM ──────────────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=mistral:7b-instruct
# Альтернативы: llama3.1:8b, qwen2.5:7b

# ─── ChromaDB ──────────────────────────────────────────
CHROMA_HOST=localhost
CHROMA_PORT=8005
CHROMA_TOKEN=pmi-chroma-token

# ─── Playwright (CDP) ─────────────────────────────────
PLAYWRIGHT_CDP_URL=http://localhost:9222
# URL фронтенда тестируемой системы
TARGET_APP_URL=http://localhost:8080

# ─── Другие сервисы ГОСТ 34 ────────────────────────────
AUTH_SERVICE_URL=http://localhost:8001
CATALOG_SERVICE_URL=http://localhost:8002
GENERATION_SERVICE_URL=http://localhost:8003
WORKFLOW_SERVICE_URL=http://localhost:8004

# ─── Безопасность ─────────────────────────────────────
SECRET_KEY=change-me-in-production

# ─── Трассировка LLM (опционально) ───────────────────
# Langfuse (self-hosted) или LangSmith
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=pmi-agent

# Langfuse (альтернатива):
# LANGFUSE_SECRET_KEY=
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_HOST=http://localhost:3000

# ─── Grafana ──────────────────────────────────────────
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin

# ─── Логирование ──────────────────────────────────────
LOG_LEVEL=INFO
