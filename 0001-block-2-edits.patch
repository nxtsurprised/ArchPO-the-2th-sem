diff --git a/ArchPO-the-2th-sem/platform/ansible/roles/strimzi_kafka/tasks/main.yml b/ArchPO-the-2th-sem/platform/ansible/roles/strimzi_kafka/tasks/main.yml
new file mode 100644
index 0000000..df6d6aa
--- /dev/null
+++ b/ArchPO-the-2th-sem/platform/ansible/roles/strimzi_kafka/tasks/main.yml
@@ -0,0 +1,49 @@
+---
+- name: Ensure Kafka namespace exists
+  kubernetes.core.k8s:
+    state: present
+    definition:
+      apiVersion: v1
+      kind: Namespace
+      metadata:
+        name: "{{ kafka_namespace }}"
+
+- name: Download Strimzi Cluster Operator manifest
+  ansible.builtin.get_url:
+    url: "{{ strimzi_operator_manifest_url }}"
+    dest: "{{ strimzi_operator_manifest_path }}"
+    mode: "0644"
+
+- name: Set Strimzi operator namespace in downloaded manifest
+  ansible.builtin.replace:
+    path: "{{ strimzi_operator_manifest_path }}"
+    regexp: "^  namespace: .+"
+    replace: "  namespace: {{ kafka_namespace }}"
+
+- name: Apply Strimzi Cluster Operator manifest
+  kubernetes.core.k8s:
+    state: present
+    src: "{{ strimzi_operator_manifest_path }}"
+
+- name: Wait for Strimzi Cluster Operator readiness
+  kubernetes.core.k8s_info:
+    api_version: apps/v1
+    kind: Deployment
+    name: strimzi-cluster-operator
+    namespace: "{{ kafka_namespace }}"
+    wait: true
+    wait_condition:
+      type: Available
+      status: "True"
+    wait_sleep: 5
+    wait_timeout: 180
+
+- name: Apply Kafka cluster custom resource
+  kubernetes.core.k8s:
+    state: present
+    definition: "{{ lookup('template', 'kafka-cluster.yaml.j2') | from_yaml }}"
+
+- name: Apply Kafka topic custom resource
+  kubernetes.core.k8s:
+    state: present
+    definition: "{{ lookup('template', 'kafka-topic.yaml.j2') | from_yaml }}"
diff --git a/ArchPO-the-2th-sem/platform/ansible/roles/strimzi_kafka/templates/kafka-cluster.yaml.j2 b/ArchPO-the-2th-sem/platform/ansible/roles/strimzi_kafka/templates/kafka-cluster.yaml.j2
